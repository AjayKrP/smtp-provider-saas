# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas (or any replica set — transactions are required for signup).
# Docker Compose reads this value as-is; do NOT add directConnection for Atlas SRV URIs.
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/smtp_saas?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173

JWT_ACCESS_SECRET=REPLACE_ME_access
JWT_REFRESH_SECRET=REPLACE_ME_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: SPF include token you publish for your sending IPs (shown to customers).
MAIL_SPF_INCLUDE=_spf.mail.example.com
# Hostname shown to customers for their SMTP client (defaults to the API host).
SMTP_PUBLIC_HOST=mail.example.com

# ---------------------------------------------------------------------------
# SMTP ingress (apps/smtp-ingress)
# ---------------------------------------------------------------------------
SMTP_SUBMISSION_PORT=587
SMTP_TLS_PORT=465
# HELO / EHLO name announced to remote MX servers. MUST have valid forward + reverse DNS.
SMTP_HOSTNAME=mail.example.com
# PEM files for the submission server's STARTTLS/TLS. Optional in dev (self-signed generated).
SMTP_TLS_CERT_PATH=
SMTP_TLS_KEY_PATH=
SMTP_MAX_MESSAGE_BYTES=26214400

# ---------------------------------------------------------------------------
# Worker (apps/worker)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
# messages per second per worker, across all destinations
WORKER_RATE_LIMIT_PER_SEC=10
# Envelope-sender / Return-Path domain for bounces (needs its own SPF + MX -> your inbound).
BOUNCE_DOMAIN=bounces.example.com
# Override MX resolution for local testing, e.g. 127.0.0.1:1025 (maildev). Comma-separated host:port.
DELIVERY_MX_OVERRIDE=
# Max delivery attempts before a deferred message is marked failed.
DELIVERY_MAX_ATTEMPTS=10
